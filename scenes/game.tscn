[node name="Text" type="Label" parent="Screen/Tutorial/Panel/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 18
text = "1. Leia a mensagem e procure pistas: remetente estranho, pressa, pedido de senha, código ou dinheiro.
2. Escolha uma ação nos botões da direita. Depois, as pistas aparecem marcadas e explicadas.
3. Errou? Um cadeado se apaga. Sem os 3 cadeados, o hacker invade o sistema.

DENUNCIAR avisa a empresa e protege outras pessoas. BLOQUEAR impede o contato de voltar. Nos golpes, os dois valem nota máxima.
Cuidado: nem toda mensagem é golpe!"
autowrap_mode = 3

