; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Click Seguro"
config/description="Jogo educativo sobre ética digital e segurança na internet."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/images/icon.svg"
boot_splash/bg_color=Color(0.012, 0.02, 0.035, 1)
boot_splash/show_image=false

[audio]

general/text_to_speech=true

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
Audio="*res://scripts/autoload/audio.gd"
SceneTransition="*res://scripts/autoload/scene_transition.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom="res://assets/ui/theme.tres"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.012, 0.02, 0.035, 1)
